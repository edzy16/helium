+
+void BrowserView::UpdateImmersiveModeState() {
+  immersive_mode_enabled_ = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      helium::kEnableImmersiveModeCommandLine);
+
+  if (immersive_mode_enabled_) {
+    // Don't enable immersive mode in fullscreen, PWA, or when DevTools is docked
+    if (IsFullscreen() || browser_->is_type_app() || browser_->is_type_pwa()) {
+      immersive_mode_enabled_ = false;
+      return;
+    }
+
+    // Initialize mouse watcher for top edge detection
+    if (!mouse_watcher_) {
+      mouse_watcher_ = std::make_unique<views::MouseWatcher>(
+          std::make_unique<views::MouseWatcherViewHost>(this, gfx::Insets(0, 0, height() - 3, 0)),
+          this);
+      mouse_watcher_->Start();
+    }
+
+    // Initially hide the top container
+    top_container_revealed_ = false;
+    HideTopContainer();
+  } else {
+    // Clean up mouse watcher
+    mouse_watcher_.reset();
+    top_container_revealed_ = true;
+  }
+}
+
+void BrowserView::RevealTopContainer() {
+  if (!IsImmersiveModeEnabled() || top_container_revealed_) {
+    return;
+  }
+
+  hide_timer_.Stop();
+  top_container_revealed_ = true;
+
+  // Animate the top container sliding down
+  if (top_container_->layer()) {
+    gfx::Transform transform;
+    top_container_->layer()->SetTransform(transform);
+
+    ui::LayerAnimator* animator = top_container_->layer()->GetAnimator();
+    animator->StopAnimating();
+    animator->AnimateToTransform(gfx::Transform(), base::Milliseconds(200));
+  }
+
+  top_container_->SetVisible(true);
+  InvalidateLayout();
+}
+
+void BrowserView::HideTopContainer() {
+  if (!IsImmersiveModeEnabled() || !top_container_revealed_) {
+    return;
+  }
+
+  top_container_revealed_ = false;
+
+  // Animate the top container sliding up
+  if (top_container_->layer()) {
+    gfx::Transform transform;
+    transform.Translate(0, -top_container_->height());
+    top_container_->layer()->SetTransform(transform);
+
+    ui::LayerAnimator* animator = top_container_->layer()->GetAnimator();
+    animator->StopAnimating();
+    animator->AnimateToTransform(transform, base::Milliseconds(200));
+  }
+
+  InvalidateLayout();
+}
+
+void BrowserView::ScheduleHideTopContainer() {
+  hide_timer_.Start(FROM_HERE, base::Milliseconds(1000),
+                    base::BindOnce(&BrowserView::HideTopContainer, base::Unretained(this)));
+}
